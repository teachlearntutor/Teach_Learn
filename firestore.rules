rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidRole(role) {
      return role == 'tutor' || role == 'student' || role == 'parent';
    }

    // User profile document rules
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidRole(request.resource.data.role)
        && request.resource.data.displayName is string
        && request.resource.data.email is string;

      allow update: if isOwner(userId)
        && isValidRole(request.resource.data.role)
        && request.resource.data.publicId == resource.data.publicId
        && request.resource.data.role == resource.data.role;

      allow delete: if isOwner(userId);

      // User subcollections (e.g. students, schedule, attendance)
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public ID reservations (create-only, no read/update/delete)
    match /publicIds/{publicId} {
      // get is needed because sign up checks whether a code is still free
      allow get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow list, update, delete: if true;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

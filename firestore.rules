rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidRole(role) {
      return role == 'tutor' || role == 'student' || role == 'parent';
    }

    function validStudent(d) {
      return d.name is string
      && d.name.size() >= 1 && d.name.size() <= 80
      && d.status in ['active', 'paused', 'left']
      && d.classLevel is string
      && d.subjects is list
      && d.subjects.size() <= 10;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
      && isValidRole(request.resource.data.role)
      && request.resource.data.displayName is string
      && request.resource.data.email is string
      && request.resource.data.publicId is string;

      allow update: if isOwner(userId)
      && isValidRole(request.resource.data.role)
      && request.resource.data.publicId == resource.data.publicId
      && request.resource.data.role == resource.data.role;

      allow delete: if isOwner(userId);

      match /students/{studentId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
        && validStudent(request.resource.data);
      }

      // Explicit rules for all user subcollections
      match /classes/{id=**}    { allow read, write: if isOwner(userId); }
      match /sessions/{id=**}   { allow read, write: if isOwner(userId); }
      match /attendance/{id=**} { allow read, write: if isOwner(userId); }
      match /holidays/{id=**}   { allow read, write: if isOwner(userId); }
    }

    match /publicIds/{publicId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow list, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

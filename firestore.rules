rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidRole(role) {
      return role == 'tutor' || role == 'student' || role == 'parent';
    }

    function isTutorUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tutor';
    }

    function validStudent(d) {
      return d.name is string
      && d.name.size() >= 1 && d.name.size() <= 80
      && d.status in ['active', 'paused', 'left']
      && d.classLevel is string
      && d.subjects is list
      && d.subjects.size() <= 10;
    }

    function validTutorProfile(d) {
      return d.displayName is string
      && d.isPublished is bool
      && d.headline is string && d.headline.size() <= 100
      && d.bio is string && d.bio.size() <= 1000
      && d.subjects is list && d.subjects.size() <= 10
      && d.levels is list && d.levels.size() <= 10;
    }

    function validLessonRequest(d, reqId) {
      return reqId == d.fromUid + '_' + d.toUid
      && d.subject is string && d.subject.size() <= 60
      && d.message is string && d.message.size() <= 500;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
      && isValidRole(request.resource.data.role)
      && request.resource.data.displayName is string
      && request.resource.data.email is string
      && request.resource.data.publicId is string;

      allow update: if isOwner(userId)
      && isValidRole(request.resource.data.role)
      && request.resource.data.publicId == resource.data.publicId
      && request.resource.data.role == resource.data.role;

      allow delete: if isOwner(userId);

      match /students/{studentId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
        && validStudent(request.resource.data);
      }

      // Explicit rules for all user subcollections
      match /classes/{id=**}    { allow read, write: if isOwner(userId); }
      match /sessions/{id=**}   { allow read, write: if isOwner(userId); }
      match /attendance/{id=**} { allow read, write: if isOwner(userId); }
      match /holidays/{id=**}   { allow read, write: if isOwner(userId); }
    }

    // Tutor Marketplace Profiles
    match /tutorProfiles/{tutorUid} {
      allow read: if isSignedIn() && (resource == null || resource.data.isPublished == true || request.auth.uid == tutorUid);
      allow create, update: if isOwner(tutorUid)
        && isTutorUser()
        && validTutorProfile(request.resource.data);
      allow delete: if isOwner(tutorUid);

      // Private contact subcollection (phone number)
      match /private/contact {
        allow write: if isOwner(tutorUid);
        allow read: if isOwner(tutorUid) || (
          isSignedIn() &&
          exists(/databases/$(database)/documents/lessonRequests/$(request.auth.uid + '_' + tutorUid)) &&
          get(/databases/$(database)/documents/lessonRequests/$(request.auth.uid + '_' + tutorUid)).data.status == 'accepted'
        );
      }
    }

    // Lesson Requests
    match /lessonRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );

      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && validLessonRequest(request.resource.data, requestId);

      allow update: if isSignedIn() && validLessonRequest(request.resource.data, requestId) && (
        // Tutor accept/decline when pending
        (request.auth.uid == resource.data.toUid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        ||
        // Learner cancel when pending or accepted (declined stays blocked)
        (request.auth.uid == resource.data.fromUid
          && resource.data.status in ['pending', 'accepted']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        ||
        // Learner re-request after cancel
        (request.auth.uid == resource.data.fromUid
          && resource.data.status == 'cancelled'
          && request.resource.data.status == 'pending')
      );

      allow delete: if false;
    }

    // Public ID reservations (create-only, no read/update/delete)
    match /publicIds/{publicId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow list, update, delete: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
